<mxfile host="Electron" agent="Mozilla/5.0">
  <diagram id="academic-year-sequence" name="Academic Year Sequence Diagram">
    <mxGraphModel dx="950" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="950" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- ===== LIFELINES ===== -->
        <mxCell id="2" parent="1" style="shape=umlLifeline;html=1;strokeWidth=2;fontSize=12;whiteSpace=wrap;overflow=hidden;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="Admin" vertex="1">
          <mxGeometry height="840" width="110" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="shape=umlLifeline;html=1;strokeWidth=2;fontSize=12;whiteSpace=wrap;overflow=hidden;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value=":AcademicYearPage" vertex="1">
